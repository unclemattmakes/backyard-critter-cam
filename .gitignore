# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
# packaging leftovers from an editable/`pip install .` of pyproject.toml (regenerated, never edited)
*.egg-info/
build/
dist/

# ===== Virtual environment =====
.venv/
venv/
env/

# ===== Captured data & runtime output (regenerated by the rig; large/binary) =====
# saved detection crops, optional full frames, and tune.py camera-tuning image sets
crops/
frames/
tuning/
# reid.py contact-sheet montages (regenerated from the embeddings on demand)
reid/
# behaviour clips (phase-4 video capture; large/binary, --record-clips)
clips/
# browser-playable H.264 transcodes of clips (regenerated on demand by the web dashboard)
clips_web/
# pruned clips restored out of the backup zips for playback (small LRU cache, web.py)
archive_cache/
# representative tracklet frame-crops (un-blend UI thumbnails; regenerated by clipembed.py)
clip_crops/
# CERTIFIED IDENTITY REFERENCE BATCHES (refcam.py) and the detector crops / video frames cut from
# them. These are hand-held photos and videos, so unlike the rig's tight animal crops they capture
# whatever the photographer was standing in front of -- houses, gardens, windows, people. NEVER
# commit them: this repo is public, and a reference set is the most personally identifying data the
# project touches. The crops/frames are a regenerable cache (re-run `refcam.py --apply --crop`).
reference/
reference_crops/
# REFERENCE IMAGES FOR THE FURNITURE VETO (refimg.py) -- the same reasoning as reference/ above,
# one step further. These are not tight animal crops: they are FULL FRAMES of the yard, certified
# empty, which is to say pictures of the house, the door, the fence and whatever was parked in the
# driveway, several per night. Never commit them -- this repo is public. Regenerable: the rig
# certifies a fresh one within minutes of starting, and every past one is replayable from the
# reference_images rows only for as long as the PNGs are kept locally.
refimg_store/
# rotating run log (backyard_cam.py tees stdout/stderr here for post-mortems; regenerated)
logs/
# eval.py evaluation artifacts (timestamped JSON runs; regenerated on demand, comparable on disk)
reports/

# ===== Model weights (auto-download from Zenodo on first run) =====
weights/
*.pt
*.onnx
*.engine

# ===== Detections database (live SQLite + WAL/SHM; binary, constantly written) =====
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Plain-text sidecars written beside the DB. Both carry private capture paths (SD-card filenames,
# crop paths) and neither is matched by *.db:
#   backyard.db.imported-<source>.txt        -- import ledger, read back to dedupe a re-import
#   backyard.db.static-dropped-<source>.txt  -- what a staticfilter sweep deleted (append-only
#                                               recovery record; keep it beside the DB, never
#                                               commit it)
*.imported-*.txt
*.static-dropped-*.txt

# ===== Local private config (real coordinates / machine-specific overrides) =====
config_local.py

# ===== Runtime status (live-naming helper heartbeat; regenerated each run) =====
.naming_status.json
.naming_status.tmp

# ===== Local tooling / editor / OS =====
# .claude/ holds a machine-specific launch.json (absolute venv path)
.claude/
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# ===== Making-of showcase (committed frozen export) =====
# making-of/ is a static, shareable site whose baked demo imagery must travel
# with the repo. Its media/crops/ and media/frames/ subdirs would otherwise be
# swallowed by the global crops/ and frames/ ignores above -- re-include them.
!making-of/media/crops/
!making-of/media/crops/**
!making-of/media/frames/
!making-of/media/frames/**
