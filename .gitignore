# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Virtual environment =====
.venv/
venv/
env/

# ===== Captured data & runtime output (regenerated by the rig; large/binary) =====
# saved detection crops, optional full frames, and tune.py camera-tuning image sets
crops/
frames/
tuning/
# reid.py contact-sheet montages (regenerated from the embeddings on demand)
reid/
# behaviour clips (phase-4 video capture; large/binary, --record-clips)
clips/
# browser-playable H.264 transcodes of clips (regenerated on demand by the web dashboard)
clips_web/
# representative tracklet frame-crops (un-blend UI thumbnails; regenerated by clipembed.py)
clip_crops/
# rotating run log (backyard_cam.py tees stdout/stderr here for post-mortems; regenerated)
logs/
# eval.py evaluation artifacts (timestamped JSON runs; regenerated on demand, comparable on disk)
reports/

# ===== Model weights (auto-download from Zenodo on first run) =====
weights/
*.pt
*.onnx
*.engine

# ===== Detections database (live SQLite + WAL/SHM; binary, constantly written) =====
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# trail-cam import ledger written beside the DB (private SD-card filenames; not matched by *.db)
*.imported-*.txt

# ===== Local private config (real coordinates / machine-specific overrides) =====
config_local.py

# ===== Runtime status (live-naming helper heartbeat; regenerated each run) =====
.naming_status.json
.naming_status.tmp

# ===== Local tooling / editor / OS =====
# .claude/ holds a machine-specific launch.json (absolute venv path)
.claude/
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# ===== Making-of showcase (committed frozen export) =====
# making-of/ is a static, shareable site whose baked demo imagery must travel
# with the repo. Its media/crops/ and media/frames/ subdirs would otherwise be
# swallowed by the global crops/ and frames/ ignores above -- re-include them.
!making-of/media/crops/
!making-of/media/crops/**
!making-of/media/frames/
!making-of/media/frames/**
